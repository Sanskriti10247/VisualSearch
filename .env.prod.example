# Settings for docker-compose.prod.yml. Copy to .env (git-ignored) and edit.
# See docs/deployment.md.

# Public hostname; its DNS record must point at this server.
VS_DOMAIN=search.example.com

# Basic auth for the upload, job and DELETE endpoints. Generate the hash with
#   docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains `$`, which Compose would interpolate.
VS_ADMIN_USER=admin
VS_ADMIN_PASSWORD_HASH='$2a$14$replace.this.with.the.output.of.caddy.hash-password'

# Host data directory (catalogue, images, indexes, ...). Must be writable by uid 1000.
VS_DATA_PATH=./data

# API container limits. Keep VS_TORCH_THREADS equal to VS_API_CPUS.
VS_API_CPUS=4
VS_API_MEMORY=6g
VS_TORCH_THREADS=4

# BLIP reranking: ~1 GB extra RAM once used, seconds per query on CPU.
# Set to false on small hosts.
VS_ENABLE_CROSS_ENCODER=true

# Set to 1 once scripts/fetch_models.py has run.
HF_HUB_OFFLINE=0

# Use a git SHA or date so you can roll back.
VS_IMAGE_TAG=latest

# Host ports published by Caddy.
VS_HTTP_PORT=80
VS_HTTPS_PORT=443
